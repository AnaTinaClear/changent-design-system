{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Changent Design System",
    "version": "1.0.0",
    "description": "Single source of truth for Changent decks, reporting UI, Power BI themes, and web. Brand colors and semantic status colors are kept separate by design: status colors are chosen for WCAG 2.1 AA contrast and colorblind safety, not brand matching.",
    "wcag": "2.1 AA",
    "font": "Segoe UI"
  },

  "color": {
    "brand": {
      "navy":        { "value": "#18216D", "type": "color", "comment": "Primary brand. CTAs, report titles, table headers, KPI values. 14.2:1 on white (AAA)." },
      "cyan":        { "value": "#3FC4E0", "type": "color", "comment": "Light blue. Data viz only. Fills only — 2.06:1 on white, never for text." },
      "orange":      { "value": "#F37121", "type": "color", "comment": "Brand orange. Data viz / accents. Fills only — 2.92:1 on white." },
      "green":       { "value": "#80B036", "type": "color", "comment": "Brand green. Data viz only. Fills only — 2.57:1 on white." },
      "purple":      { "value": "#7A3779", "type": "color", "comment": "Brand purple. Data viz. 7.92:1 on white (text-safe), use last in sequence." },
      "grey":        { "value": "#8B8D90", "type": "color", "comment": "Mid grey. Neutral series / no-data. 3.33:1 — large fills only." }
    },

    "neutral": {
      "white":       { "value": "#FFFFFF", "type": "color", "comment": "Dashboard background, card surface." },
      "grey-50":     { "value": "#F8F9FC", "type": "color", "comment": "Table alternating row, subtle surface." },
      "grey-100":    { "value": "#F3F2F0", "type": "color", "comment": "Filter pane / left nav background (brand spec)." },
      "grey-150":    { "value": "#E2E8F0", "type": "color", "comment": "Deck page canvas background (from QBR)." },
      "grey-200":    { "value": "#E5E6E6", "type": "color", "comment": "Gridlines, dividers, null state. Never a data series." },
      "grey-400":    { "value": "#8B8D90", "type": "color", "comment": "Muted labels on white (3.33:1 — large/secondary only)." },
      "grey-500":    { "value": "#6B7280", "type": "color", "comment": "Secondary axis labels, captions. 4.83:1 on white." },
      "grey-700":    { "value": "#535456", "type": "color", "comment": "Dark grey body alt. 7.58:1 on white (AAA)." },
      "ink":         { "value": "#22292A", "type": "color", "comment": "Smokey grey. Default body / title text. 14.8:1 on white." }
    },

    "deck": {
      "bg-dark":     { "value": "#051E48", "type": "color", "comment": "Title & closing slide background, header bar (from QBR). 16.3:1 with white." },
      "bg-canvas":   { "value": "#E2E8F0", "type": "color", "comment": "Content slide canvas behind white cards." },
      "card":        { "value": "#FFFFFF", "type": "color", "comment": "Content card surface on the canvas." }
    },

    "semantic": {
      "_comment": "Status colors are NOT brand colors. Each has a FILL (for badges/bars/chips) and an ON-LIGHT text variant that passes 4.5:1 on white. Amber fill REQUIRES dark text on top — white fails (1.69:1). Always pair status color with an icon or label; never rely on color alone.",

      "success": {
        "fill":      { "value": "#198F51", "type": "color", "comment": "Completed / on-target. White text OK at 18pt+ bold (4.13:1)." },
        "text":      { "value": "#157A43", "type": "color", "comment": "Success as text/icon on white. 5.39:1 (AA)." },
        "on-fill":   { "value": "#FFFFFF", "type": "color", "comment": "Text on the success fill (large/bold)." },
        "tint":      { "value": "#E8F4D5", "type": "color", "comment": "Subtle success background / sequential low." }
      },
      "warning": {
        "fill":      { "value": "#F3C11B", "type": "color", "comment": "In Progress / below-target. MUST use dark text (ink) on top — white fails." },
        "text":      { "value": "#7A5800", "type": "color", "comment": "Warning as text/icon on white. 6.51:1 (AA)." },
        "on-fill":   { "value": "#22292A", "type": "color", "comment": "Dark ink text on the amber fill. Never white." },
        "tint":      { "value": "#FDF2CC", "type": "color", "comment": "Subtle warning background." }
      },
      "danger": {
        "fill":      { "value": "#C00000", "type": "color", "comment": "Cancelled / critical / SLA breach. White text OK (6.48:1). Pair with ! icon." },
        "text":      { "value": "#C00000", "type": "color", "comment": "Danger as text/icon on white. 6.48:1 (AA)." },
        "on-fill":   { "value": "#FFFFFF", "type": "color", "comment": "Text on danger fill." },
        "tint":      { "value": "#FBE3E3", "type": "color", "comment": "Subtle danger background." }
      },
      "info": {
        "fill":      { "value": "#3FC4E0", "type": "color", "comment": "Highlight / selection / info callout. Fills only — dark text on top." },
        "text":      { "value": "#0E6E80", "type": "color", "comment": "Info as text/icon on white. 5.90:1 (AA)." },
        "on-fill":   { "value": "#22292A", "type": "color", "comment": "Dark text on the cyan fill. White fails (2.06:1)." },
        "tint":      { "value": "#D9F5FB", "type": "color", "comment": "Subtle info background / sequential low." }
      },
      "neutral": {
        "fill":      { "value": "#8B8D90", "type": "color", "comment": "No-data / inactive / baseline." },
        "text":      { "value": "#535456", "type": "color", "comment": "Neutral as text on white. 7.58:1 (AAA)." },
        "on-fill":   { "value": "#FFFFFF", "type": "color", "comment": "Text on neutral fill (large/bold)." },
        "tint":      { "value": "#F3F2F0", "type": "color", "comment": "Subtle neutral background." }
      }
    },

    "dataviz": {
      "_comment": "Categorical sequence — apply in this order, max 6 per visual. Group extras into tints of the same hue.",
      "categorical": {
        "1": { "value": "#18216D", "type": "color", "comment": "Dark Blue — brand anchor, primary value." },
        "2": { "value": "#3FC4E0", "type": "color", "comment": "Cyan — safest pair with navy." },
        "3": { "value": "#F37121", "type": "color", "comment": "Orange — safe with blue." },
        "4": { "value": "#8B8D90", "type": "color", "comment": "Mid Grey — neutral." },
        "5": { "value": "#80B036", "type": "color", "comment": "Green — add icon/label to differentiate." },
        "6": { "value": "#7A3779", "type": "color", "comment": "Purple — use with caution, never beside green." }
      },
      "sequential": {
        "blue":   { "low": { "value": "#EEF0F8", "type": "color" }, "mid": { "value": "#8D95C4", "type": "color" }, "high": { "value": "#18216D", "type": "color" } },
        "cyan":   { "low": { "value": "#D9F5FB", "type": "color" }, "mid": { "value": "#3FC4E0", "type": "color" }, "high": { "value": "#1B5E6E", "type": "color" } },
        "green":  { "low": { "value": "#E8F4D5", "type": "color" }, "mid": { "value": "#80B036", "type": "color" }, "high": { "value": "#4F6E22", "type": "color" } },
        "orange": { "low": { "value": "#FDE0D0", "type": "color" }, "mid": { "value": "#F37121", "type": "color" }, "high": { "value": "#8D3510", "type": "color" } }
      },
      "diverging": {
        "_comment": "Primary KPI diverging scale. Orange -> warm white -> Cyan. Colorblind safe. Always add +/- labels.",
        "min":    { "value": "#F37121", "type": "color" },
        "center": { "value": "#FFF3EC", "type": "color" },
        "max":    { "value": "#3FC4E0", "type": "color" }
      }
    }
  },

  "font": {
    "family": {
      "base": { "value": "Segoe UI, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "type": "fontFamily", "comment": "Official Power BI font. Use everywhere." }
    },
    "weight": {
      "regular":  { "value": "400", "type": "fontWeight" },
      "semibold": { "value": "600", "type": "fontWeight" },
      "bold":     { "value": "700", "type": "fontWeight" }
    },
    "size": {
      "_comment": "Deck sizes (pt) from brand typography treatment. UI sizes (px) below. Minimum 12 for incidental text, 14 for content.",
      "deck": {
        "report-title": { "value": "45pt", "type": "dimension", "comment": "Segoe UI Bold" },
        "subheader":    { "value": "24pt", "type": "dimension", "comment": "Segoe UI Bold" },
        "column-label": { "value": "18pt", "type": "dimension", "comment": "Segoe UI Regular/Semibold" },
        "sidebar-item": { "value": "14pt", "type": "dimension", "comment": "Segoe UI Semibold/Bold" },
        "filter-title": { "value": "14pt", "type": "dimension", "comment": "Segoe UI Semibold" },
        "body":         { "value": "14pt", "type": "dimension", "comment": "Segoe UI Regular" },
        "caption":      { "value": "12pt", "type": "dimension", "comment": "Dropdowns, axis titles, legends" }
      },
      "ui": {
        "display":  { "value": "32px", "type": "dimension", "comment": "KPI callout numbers" },
        "h1":       { "value": "24px", "type": "dimension" },
        "h2":       { "value": "18px", "type": "dimension" },
        "h3":       { "value": "16px", "type": "dimension" },
        "body":     { "value": "14px", "type": "dimension", "comment": "Minimum for content" },
        "caption":  { "value": "12px", "type": "dimension", "comment": "Tooltips, footnotes only" }
      }
    },
    "line-height": {
      "tight":  { "value": "1.2", "type": "number", "comment": "Titles, KPIs" },
      "normal": { "value": "1.5", "type": "number", "comment": "Body text" }
    }
  },

  "space": {
    "_comment": "4pt / 8pt grid. Use consistently; do not mix arbitrary gaps.",
    "1": { "value": "4px",  "type": "dimension" },
    "2": { "value": "8px",  "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "8": { "value": "32px", "type": "dimension" },
    "12":{ "value": "48px", "type": "dimension" }
  },

  "radius": {
    "sm":   { "value": "4px",  "type": "dimension" },
    "md":   { "value": "8px",  "type": "dimension", "comment": "Default card radius (matches QBR cards)." },
    "lg":   { "value": "12px", "type": "dimension" },
    "pill": { "value": "999px","type": "dimension", "comment": "Status chips, progress bars." }
  },

  "shadow": {
    "card": { "value": "0 1px 3px rgba(5,30,72,0.08), 0 1px 2px rgba(5,30,72,0.06)", "type": "shadow", "comment": "Subtle elevation for white cards on canvas. No accent stripes." }
  },

  "border": {
    "default": { "value": "1px solid #E5E6E6", "type": "border" },
    "strong":  { "value": "1px solid #18216D", "type": "border", "comment": "Table outline." }
  }
}
